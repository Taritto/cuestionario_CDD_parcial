        {
          "source": "gestion",
          "locator": "Conceptos básicos; fundamentos del aprendizaje automático"
        }
      ],
      "options": [
        {
          "id": "d",
          "text": "Siempre conoce todos los valores poblacionales."
        },
        {
          "id": "a",
          "text": "Generaliza desde una muestra hacia una población con incertidumbre."
        },
        {
          "id": "c",
          "text": "No utiliza probabilidades."
        },
        {
          "id": "b",
          "text": "Solo organiza datos en tablas."
        }
      ],
      "answer": [
        "a"
      ]
    },
