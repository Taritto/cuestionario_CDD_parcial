{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Banco de estudio CD, versión 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "sources",
    "topics",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "type",
        "difficulty",
        "origin",
        "points",
        "prompt",
        "explanation",
        "references"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topic": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "single",
            "multiple",
            "truefalse",
            "matching",
            "numeric",
            "essay"
          ]
        },
        "difficulty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "origin": {
          "enum": [
            "historica",
            "nueva",
            "ampliacion"
          ]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source",
              "locator"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/id"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "answer": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "id",
              "left",
              "right"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "left": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "right": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "truefalse"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "truefalse"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "true",
                        "false"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "numeric"
              }
            }
          },
          "then": {
            "required": [
              "answer",
              "tolerance"
            ],
            "properties": {
              "answer": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": [
              "pairs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "essay"
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ]
          }
        }
      ]
    }
  }
}